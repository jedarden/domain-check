# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/domain-check
./domain-check

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.out

# Dependency directories
vendor/

# Go workspace file
go.work

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Node.js / E2E tests
node_modules/
package-lock.json
playwright-report/
test-results/

# Environment files
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.log
memory-test-results/
load-test-results/

# Fuzz test crasher files (auto-generated when bugs are found)
testdata/fuzz/*/crash-*

# Fuzz test crashers (auto-generated by go test -fuzz)
testdata/fuzz/*/*.test
testdata/fuzz/*/*crash*
testdata/fuzz/*/*quota*
testdata/fuzz/*/*suppression*
RELEASE_NOTES.md

# GoReleaser build output
dist/

# Beads tracking system (prevent large JSONL file commits)
# bead-rs: checkpoint files are tracked internally but should not be committed to prevent repository bloat
.beads/checkpoint/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/receipts/
# Beads database files (prevent SQLite database commits)
*.db
*.db.backup.*
*.jsonl
# Beads history and recovery directories
.beads/.bf_history/
.beads/.br_recovery/
.beads/traces/
.beads/tmp/
