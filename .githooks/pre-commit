#!/bin/bash
# Pre-commit hook to block large file additions (>10MB)
# This prevents repository bloat by rejecting commits with files that exceed the size threshold

set -euo pipefail

# Configuration: Maximum file size in bytes (10MB default)
MAX_SIZE=${MAX_SIZE:-$((10 * 1024 * 1024))}

# Get list of staged files that are being added or copied
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACR 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    # No files being added, proceed with commit
    exit 0
fi

# Check each staged file
BLOCKED_FILES=0
for file in $STAGED_FILES; do
    # Skip deleted files
    if [ ! -f "$file" ]; then
        continue
    fi

    # Get file size (handle both macOS and Linux stat commands)
    FILE_SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)

    if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
        # Calculate size in MB for display
        SIZE_MB=$((FILE_SIZE / 1024 / 1024))
        echo "❌  ERROR: File '$file' (${SIZE_MB}MB) exceeds ${MAX_SIZE} byte limit"
        BLOCKED_FILES=$((BLOCKED_FILES + 1))
    fi
done

# If any files were blocked, fail the commit with helpful message
if [ "$BLOCKED_FILES" -gt 0 ]; then
    echo ""
    echo "Large files should not be committed to git history."
    echo "This prevents repository bloat and keeps clones/pulls fast."
    echo ""
    echo "Solutions:"
    echo "  1. Add the file to .gitignore if it shouldn't be tracked"
    echo "  2. Use Git LFS for binary assets that must be versioned"
    echo "  3. Split the file into smaller chunks if appropriate"
    echo ""
    echo "To bypass this check (not recommended): git commit --no-verify"
    exit 1
fi

exit 0
