[Unit]
Description=Domain Check Repository Full Git GC
Documentation=https://git.ardenone.com/jedarden/domain-check

[Service]
Type=oneshot
WorkingDirectory=/home/coding/domain-check
ExecStart=/home/coding/domain-check/scripts/safe-git-gc.sh --full
StandardOutput=append:/home/coding/domain-check/.beads/logs/git-gc-full.log
StandardError=append:/home/coding/domain-check/.beads/logs/git-gc-full.log
