[Unit]
Description=Domain Check Repository Health Check
Documentation=https://git.ardenone.com/jedarden/domain-check
After=network.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=%h/domain-check
ExecStart=/home/coding/domain-check/scripts/auto-gc-trigger.sh --dry-run
StandardOutput=append:/home/coding/domain-check/.beads/logs/git-gc-check.log
StandardError=append:/home/coding/domain-check/.beads/logs/git-gc-check.log
