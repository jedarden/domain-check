#!/usr/bin/env bash
# Pre-commit hook: repository bloat backstop.
#
# This is the canonical, tracked source copy. Install or verify it with
# scripts/setup-git-hooks.sh; the installed .git/hooks/pre-commit must stay
# byte-identical to this file (the installer's --check mode enforces that).
#
# Why this exists — bead bf-4yjq (2026-08-12):
#   17+ identical 237MB .beads/*.jsonl snapshots were committed, growing the
#   repository to 18GB (17.16GB loose objects). Every significant git operation
#   then died to memcg OOM — 9 crashes in 2.5 hours, all exit -1. This hook is
#   the backstop that would have blocked those commits before they entered
#   history. See docs/crash-prevention-requirements.md gap G-1.
#
# Guards, in order (all hard blocks; safe to run non-interactively):
#   1. No single staged file larger than MAX_FILE_MB.
#   2. Total staged payload no larger than MAX_COMMIT_MB.
#   3. Nothing staged under .beads/ — that directory is gitignored repo-wide,
#      so anything staged there arrived via `git add -f`.

set -euo pipefail

MAX_FILE_MB=10
MAX_COMMIT_MB=50
MAX_FILE_BYTES=$((MAX_FILE_MB * 1024 * 1024))
MAX_COMMIT_BYTES=$((MAX_COMMIT_MB * 1024 * 1024))

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

file_size() {
  # Cross-platform size of a regular file; 0 when the path is missing
  # (staged deletions, submodule pointers, intent-to-add placeholders).
  stat -f%z "$1" 2>/dev/null || stat -c%s "$1" 2>/dev/null || echo 0
}

echo -e "${GREEN}🔍 Pre-commit check: Scanning for large files...${NC}"

large_files=()
bead_files=()
total_bytes=0

# -z keeps paths with spaces or newlines intact; --diff-filter drops staged
# deletions; renames report their destination path. The loop body runs in this
# shell (process substitution, not a pipe), so the accumulators persist.
while IFS= read -r -d '' file; do
  [ -f "$file" ] || continue

  size=$(file_size "$file")
  total_bytes=$((total_bytes + size))

  if [ "$size" -gt "$MAX_FILE_BYTES" ]; then
    large_files+=("$file ($((size / 1048576)) MB)")
  fi

  case "$file" in
    # The whole .beads/ tree is gitignored (gitignore rule `.beads/`), so any
    # staged path under it — beads.db, checkpoint/, logs/, state/ — can only
    # have arrived via `git add -f`. Block all of it, not just the .jsonl
    # shapes bf-4yjq actually leaked; the next leak need not be a .jsonl.
    .beads/* | .beads/)
      bead_files+=("$file")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

bloat_help() {
  echo -e "${YELLOW}Maximum file size: ${MAX_FILE_MB} MB, total per commit: ${MAX_COMMIT_MB} MB${NC}"
  echo ""
  echo -e "${YELLOW}To fix this issue:${NC}"
  echo "  1. Add the file to .gitignore:  echo \"\$file\" >> .gitignore"
  echo "  2. Unstage it:                  git restore --staged \"\$file\""
  echo "  3. Genuinely large binaries:    git lfs install && git lfs track \"\$file\""
  echo ""
  echo -e "${YELLOW}⚠️  Large files in git history cause repository bloat${NC}"
  echo "     Bloat turns every git operation into an OOM risk (bead bf-4yjq)."
}

if [ "${#large_files[@]}" -gt 0 ]; then
  echo -e "${RED}❌ COMMIT BLOCKED - Large files detected:${NC}"
  echo ""
  for entry in "${large_files[@]}"; do
    echo -e "  ${RED}✗${NC} $entry"
  done
  echo ""
  bloat_help
  exit 1
fi

if [ "$total_bytes" -gt "$MAX_COMMIT_BYTES" ]; then
  echo -e "${RED}❌ COMMIT BLOCKED - Total staged size $((total_bytes / 1048576)) MB exceeds ${MAX_COMMIT_MB} MB${NC}"
  echo "   No single file hit the ${MAX_FILE_MB} MB limit, but the commit as a whole is too large."
  echo ""
  bloat_help
  exit 1
fi

if [ "${#bead_files[@]}" -gt 0 ]; then
  echo -e "${RED}❌ COMMIT BLOCKED - Bead workspace files staged:${NC}"
  echo ""
  for entry in "${bead_files[@]}"; do
    echo -e "  ${RED}✗${NC} $entry"
  done
  echo ""
  echo -e "${YELLOW}These paths are gitignored; they were staged with 'git add -f'.${NC}"
  echo "Unstage them:  git restore --staged \"\$file\""
  echo ""
  echo -e "${YELLOW}Committing bead state is what bloated this repo to 18GB (bf-4yjq).${NC}"
  exit 1
fi

echo -e "${GREEN}✅ Pre-commit check passed${NC}"
exit 0
